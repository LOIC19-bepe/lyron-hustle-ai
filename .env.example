# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret JWT — OBLIGATOIRE. L'application refuse de démarrer sans cette valeur.
# Générer une valeur forte (ne jamais committer la vraie valeur) :
#   Linux/macOS : openssl rand -hex 32
#   PowerShell  : -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_SECRET=

# --- IA (optionnel) ---
# Toute API compatible OpenAI (OpenAI, Groq, Mistral…).
# Sans clé, l'assistant utilise l'analyste déterministe intégré.
# AI_API_KEY=
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Flutterwave Standard (TEST only) ---
# TEST credentials only. Never expose FLW_SECRET_KEY with a NEXT_PUBLIC_ prefix.
APP_URL=http://localhost:3000
FLW_MODE=test
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
